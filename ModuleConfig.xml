<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://qconsulting.ca/fo3/ModConfig5.0.xsd">
  <moduleName>Faster Space Station Landing</moduleName>
  <installSteps order="Explicit">
    <installStep name="Choose landing speed">
      <optionalFileGroups order="Explicit">
        <group name="Speed" type="SelectExactlyOne">
          <plugins order="Explicit">
            <plugin name="10x">
              <description>10x faster station and anomaly landing</description>
              <files>
                <folder source="10x" destination="Faster Space Station Landing - 10x" priority="0" />
              </files>
              <typeDescriptor>
                <type name="Optional" />
              </typeDescriptor>
            </plugin>
            <plugin name="5x">
              <description>5x faster station and anomaly landing</description>
              <files>
                <folder source="5x" destination="Faster Space Station Landing - 5x" priority="0" />
              </files>
              <typeDescriptor>
                <type name="Optional" />
              </typeDescriptor>
            </plugin>
            <plugin name="2x">
              <description>2x faster station and anomaly landing</description>
              <files>
                <folder source="2x" destination="Faster Space Station Landing - 2x" priority="0" />
              </files>
              <typeDescriptor>
                <type name="Optional" />
              </typeDescriptor>
            </plugin>
          </plugins>
        </group>
      </optionalFileGroups>
    </installStep>
  </installSteps>
</config>
